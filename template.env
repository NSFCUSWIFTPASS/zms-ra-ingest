# Logging
RA_INGEST_LOG_LEVEL=INFO

# ZMS connection
RA_INGEST_ZMC_URL=http://zms-zmc-local-dev:8010/v1
RA_INGEST_RA_URL=http://zms-ra-local-dev:8050
RA_INGEST_RA_VERIFY_SSL=true
RA_INGEST_TOKEN=your-zms-api-token

# RA facility identity in ZMS
RA_INGEST_ELEMENT_ID=00000000-0000-0000-0000-000000000000

# Google Calendar sync (required; runs on the same poll interval as ODS)
RA_INGEST_GCAL_CALENDAR_ID=
RA_INGEST_GCAL_CALENDAR_TOKEN=
RA_INGEST_GCAL_LOOKAHEAD_DAYS=28
# Grant priority (-1023..1023). Lower than the ODS sources' priority (set in
# sources.json, default 1023) so an observation preempts an overlapping
# calendar block; the calendar grant returns to active when the observation ends.
RA_INGEST_GCAL_PRIORITY=900
# Calendar events with no parseable Center Frequency + Bandwidth are skipped
# (a grant must protect a real band; there is no default freq fallback).
RA_INGEST_GCAL_FILTER_EXC=^ENGINEERING DOWN,^INACTIVE,^Generator Replacement
RA_INGEST_GCAL_FILTER_INC=
RA_INGEST_GCAL_VERIFY_SSL=true

# Poll behavior
RA_INGEST_POLL_INTERVAL_SECONDS=300

# Path to sources configuration
RA_INGEST_SOURCES_CONFIG=sources.json

# Daily email reports (optional)
RA_INGEST_REPORT_ENABLED=false
RA_INGEST_REPORT_CRON=0 8 * * *
RA_INGEST_SMTP_HOST=smtp.gmail.com
RA_INGEST_SMTP_PORT=587
RA_INGEST_SMTP_USER=
RA_INGEST_SMTP_PASSWORD=
RA_INGEST_REPORT_FROM=
RA_INGEST_REPORT_TO=
